<!DOCTYPE html>
<html lang="en" class="no-js">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=5.0" />
    <meta name="description" content="A cinematic romantic surprise and love story for Piu." />
    <title>@ViewData["Title"]</title>

    <!-- Google Fonts: Editorial Serif + Clean Sans -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;0,600;1,400;1,600&family=Outfit:wght@200;300;400;500;600&family=Playfair+Display:ital,wght@0,400;0,600;0,700;1,400&display=swap" rel="stylesheet">

    <!-- Styles -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="cinematic-body">
    <a href="#main-content" class="skip-to-content">Skip to content</a>

    <!-- Subtle Ambient Stardust & Particle Canvas -->
    <canvas id="particleCanvas" class="particle-canvas" aria-hidden="true"></canvas>

    <!-- Desktop Magnetic Follower Cursor -->
    <div id="customCursor" class="custom-cursor" aria-hidden="true">
        <div class="cursor-dot"></div>
        <div class="cursor-ring"></div>
    </div>

    <!-- Minimal Floating Navigation Indicator -->
    <nav class="nav-indicator" id="navIndicator" aria-label="Story sections navigation">
        <button type="button" class="nav-dot active" data-target="#hero" aria-label="Hero section"></button>
        <button type="button" class="nav-dot" data-target="#intro" aria-label="Introduction section"></button>
        <button type="button" class="nav-dot" data-target="#countdown" aria-label="Countdown section"></button>
        <button type="button" class="nav-dot" data-target="#gallery" aria-label="Gallery section"></button>
        <button type="button" class="nav-dot" data-target="#memories" aria-label="Memories section"></button>
        <button type="button" class="nav-dot" data-target="#thingsILove" aria-label="Things I Love section"></button>
        <button type="button" class="nav-dot" data-target="#letter" aria-label="Personal Letter section"></button>
        <button type="button" class="nav-dot" data-target="#final" aria-label="Final Celebration section"></button>
    </nav>

    <!-- Optional Floating Music Controller -->
    <div id="musicController" class="music-controller hidden" aria-label="Music control" role="region">
        <button id="musicToggleBtn" class="music-btn" aria-label="Toggle background music" aria-pressed="false" title="Play / Pause background music">
            <span class="music-icon" aria-hidden="true">
                <span class="bar bar-1"></span>
                <span class="bar bar-2"></span>
                <span class="bar bar-3"></span>
                <span class="bar bar-4"></span>
            </span>
            <span class="music-label">Music</span>
        </button>
        <audio id="bgAudio" preload="none" loop></audio>
    </div>

    <!-- Main Content Container -->
    <main id="main-content" class="cinematic-wrapper">
        @RenderBody()
    </main>

    <!-- Fullscreen Accessible Photo Lightbox Dialog -->
    <dialog id="galleryLightbox" class="lightbox-dialog" aria-modal="true" aria-label="Photo Lightbox" closedby="any">
        <div class="lightbox-backdrop"></div>
        <div class="lightbox-container" role="document">
            <button type="button" id="lightboxCloseBtn" class="lightbox-btn lightbox-close" aria-label="Close photo view">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <line x1="18" y1="6" x2="6" y2="18"></line>
                    <line x1="6" y1="6" x2="18" y2="18"></line>
                </svg>
            </button>

            <button type="button" id="lightboxPrevBtn" class="lightbox-btn lightbox-prev" aria-label="Previous photo">
                <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <polyline points="15 18 9 12 15 6"></polyline>
                </svg>
            </button>

            <div class="lightbox-stage">
                <div class="lightbox-image-wrapper">
                    <img id="lightboxImage" src="" alt="Enlarged memory photograph" class="lightbox-img" />
                </div>
                <div class="lightbox-caption-bar">
                    <span id="lightboxCounter" class="lightbox-counter">01 / 01</span>
                    <span id="lightboxCaption" class="lightbox-caption">Memory</span>
                </div>
            </div>

            <button type="button" id="lightboxNextBtn" class="lightbox-btn lightbox-next" aria-label="Next photo">
                <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <polyline points="9 18 15 12 9 6"></polyline>
                </svg>
            </button>
        </div>
    </dialog>

    <!-- Third Party Animation Engines (GSAP 3, ScrollTrigger, Canvas Confetti) -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/gsap.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/ScrollTrigger.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/canvas-confetti@1.9.3/dist/confetti.browser.min.js"></script>

    <!-- Application Script -->
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
