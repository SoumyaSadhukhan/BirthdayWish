@using Microsoft.Extensions.Configuration
@inject IConfiguration Config
@{
    var guideEnabled = Config.GetValue<bool>("BirthdayConfig:AngelGuideMessages:Enabled", true);
    if (!guideEnabled) return;
}

<!-- 3D Angel Guide Configuration -->
<script>
    window.AngelConfig = {
        enabled: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(guideEnabled)),
        roamingEnabled: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Config.GetValue<bool>("BirthdayConfig:AngelGuideMessages:RoamingEnabled", true))),
        fixedPosition: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Config.GetValue<bool>("BirthdayConfig:AngelGuideMessages:FixedPosition", false))),
        standingTimeSec: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Config.GetValue<double>("BirthdayConfig:AngelGuideMessages:StandingTimeSec", 5.0))),
        flyTimePerUnitSec: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Config.GetValue<double>("BirthdayConfig:AngelGuideMessages:FlyTimePerUnitSec", 1.0))),
        takeoffTransitionTimeSec: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Config.GetValue<double>("BirthdayConfig:AngelGuideMessages:TakeoffTransitionTimeSec", 0.5))),
        landingTransitionTimeSec: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Config.GetValue<double>("BirthdayConfig:AngelGuideMessages:LandingTransitionTimeSec", 0.7))),
        messages: {
            indexWaiting: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Config["BirthdayConfig:AngelGuideMessages:Screen1_Index_Waiting"])),
            indexFinished: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Config["BirthdayConfig:AngelGuideMessages:Screen1_Index_Finished"])),
            wish: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Config["BirthdayConfig:AngelGuideMessages:Screen2_Wish"])),
            cakeCandle: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Config["BirthdayConfig:AngelGuideMessages:Screen3_Cake_Candle"])),
            cakeCut: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Config["BirthdayConfig:AngelGuideMessages:Screen3_Cake_Cut"])),
            cakeBite: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Config["BirthdayConfig:AngelGuideMessages:Screen3_Cake_Bite"])),
            cakeBiteMore: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Config["BirthdayConfig:AngelGuideMessages:Screen3_Cake_BiteMore"])),
            cakeDone: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Config["BirthdayConfig:AngelGuideMessages:Screen3_Cake_Done"])),
            giftInitial: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Config["BirthdayConfig:AngelGuideMessages:Screen4_Gift_Initial"])),
            giftFlowers: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Config["BirthdayConfig:AngelGuideMessages:Screen4_Gift_Flowers"])),
            giftTeddy: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Config["BirthdayConfig:AngelGuideMessages:Screen4_Gift_Teddy"])),
            giftChocolates: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Config["BirthdayConfig:AngelGuideMessages:Screen4_Gift_Chocolates"])),
            giftEnvelope: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Config["BirthdayConfig:AngelGuideMessages:Screen4_Gift_Envelope"])),
            giftPhotos: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Config["BirthdayConfig:AngelGuideMessages:Screen4_Gift_Photos"])),
            giftPuzzle: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Config["BirthdayConfig:AngelGuideMessages:Screen4_Gift_Puzzle"])),
            giftDone: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Config["BirthdayConfig:AngelGuideMessages:Screen4_Gift_Done"]))
        },
        modelUrl: "/models/angel/angel.glb",
        initialPosition: { x: 2, y: 1.2, z: 0 },
        scale: 1.0,
        mobileScale: 0.75,
        shadowEnabled: true,
        dialogueEnabled: true
    };
</script>

<!-- 3D Angel Guide Stylesheet -->
<link rel="stylesheet" href="~/css/angel/angel.css" asp-append-version="true" />

<!-- Three.js & GLTFLoader CDN Libraries -->
<script src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/three@0.128.0/examples/js/loaders/GLTFLoader.js"></script>

<!-- 3D Angel Guide System Modules -->
<script src="~/js/angel/AngelRenderer.js" asp-append-version="true"></script>
<script src="~/js/angel/AngelAnimator.js" asp-append-version="true"></script>
<script src="~/js/angel/AngelFlight.js" asp-append-version="true"></script>
<script src="~/js/angel/AngelTargetManager.js" asp-append-version="true"></script>
<script src="~/js/angel/AngelDialogue.js" asp-append-version="true"></script>
<script src="~/js/angel/AngelPageBehavior.js" asp-append-version="true"></script>
<script src="~/js/angel/AngelInteraction.js" asp-append-version="true"></script>
<script src="~/js/angel/AngelController.js" asp-append-version="true"></script>
