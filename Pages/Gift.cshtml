                finalMsg.style.padding = '2rem';
                finalMsg.style.background = 'rgba(15, 23, 42, 0.88)';
                finalMsg.style.backdropFilter = 'blur(16px)';
                finalMsg.style.borderRadius = '20px';
                finalMsg.style.border = '1px solid rgba(251, 191, 36, 0.3)';
