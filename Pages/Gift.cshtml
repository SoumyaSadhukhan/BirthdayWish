        const droneArrangeDurationSec = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Config.GetValue<double>("BirthdayConfig:DroneArrangeDurationSec", 1.5)));
        const droneShowtimeSec = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Config.GetValue<double>("BirthdayConfig:DroneShowtimeSec", 3.0)));
        const droneSpreadDurationSec = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Config.GetValue<double>("BirthdayConfig:DroneSpreadDurationSec", 2.0)));
