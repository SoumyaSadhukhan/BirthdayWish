                finalMsg.style.display = 'block';
                gsap.fromTo(finalMsg, { opacity: 0, scale: 0.7 }, { opacity: 1, scale: 1, duration: 1.2, ease: 'back.out(1.5)' });
            }
        }
        
        let blankIndex = (puzzleRows * puzzleCols) - 1; // The empty spot
        
        function initPuzzle() {
            if (allImages.length > 0) {
                puzzleImage = allImages[Math.floor(Math.random() * allImages.length)];
            }
            if (!puzzleImage) return;
            
            const board = document.getElementById('puzzle-board');
            board.innerHTML = ''; // clear
            board.style.pointerEvents = 'auto'; // allow pieces to be clicked!
            puzzlePieces.length = 0;
            
            const pieceW = 320 / puzzleCols;
            const pieceH = 320 / puzzleRows;
            const totalPieces = (puzzleRows * puzzleCols) - 1;
            
            for (let i = 0; i < totalPieces; i++) {
                const row = Math.floor(i / puzzleCols);
                const col = i % puzzleCols;
                
                const piece = document.createElement('div');
                piece.className = 'puzzle-piece';
                piece.style.width = pieceW + 'px';
                piece.style.height = pieceH + 'px';
                piece.style.backgroundImage = `url('${puzzleImage}')`;
                
                const correctX = col * pieceW;
                const correctY = row * pieceH;
                
                piece.style.backgroundPosition = `-${correctX}px -${correctY}px`;
                
                piece.dataset.correctIndex = i;
                piece.dataset.currentIndex = i;
                
                gsap.set(piece, { x: correctX, y: correctY });
                
                board.appendChild(piece);
                puzzlePieces.push(piece);
                
                ['click', 'touchstart'].forEach(evt => {
                    piece.addEventListener(evt, (e) => {
                        e.stopPropagation();
                        e.preventDefault(); // prevent double firing on mobile
                        handlePieceSlide(piece);
                    });
                });
            }
            blankIndex = (puzzleRows * puzzleCols) - 1;
        }

        function scramblePuzzle() {
            puzzleActive = true;
            instruction.innerText = txtScrambled;
            instruction.style.display = 'block';
            gsap.fromTo(instruction, {opacity: 0, y:20}, {opacity: 1, y:0, duration:0.5});
            
            const pieceW = 320 / puzzleCols;
            const pieceH = 320 / puzzleRows;
            
            let previousBlank = -1;
            let moves = 0;
            
            while (moves < 200) {
                const validNeighbors = getValidNeighbors(blankIndex);
                const possibleMoves = validNeighbors.filter(n => n !== previousBlank);
                const moveToMake = possibleMoves[Math.floor(Math.random() * possibleMoves.length)];
                
                const pieceToMove = puzzlePieces.find(p => parseInt(p.dataset.currentIndex) === moveToMake);
                
                if (pieceToMove) {
                    pieceToMove.dataset.currentIndex = blankIndex;
                    previousBlank = blankIndex;
                    blankIndex = moveToMake;
                    moves++;
                }
            }
            
            // Animate pieces to their scrambled positions
            puzzlePieces.forEach((piece) => {
                const idx = parseInt(piece.dataset.currentIndex);
                const col = idx % puzzleCols;
                const row = Math.floor(idx / puzzleCols);
                gsap.to(piece, { x: col * pieceW, y: row * pieceH, duration: 0.8, ease: 'power2.out', delay: 0.5 + Math.random() * 0.2 });
            });
        }
        
        function getValidNeighbors(index) {
            const neighbors = [];
            const col = index % puzzleCols;
            const row = Math.floor(index / puzzleCols);
            
            if (row > 0) neighbors.push(index - puzzleCols); // Up
            if (row < puzzleRows - 1) neighbors.push(index + puzzleCols); // Down
            if (col > 0) neighbors.push(index - 1); // Left
            if (col < puzzleCols - 1) neighbors.push(index + 1); // Right
            
            return neighbors;
        }

        function handlePieceSlide(piece) {
            if (!isPuzzleMode && !puzzleSolved) {
                puzzleActive = false;
                puzzleSolved = true;
                const tl = gsap.timeline();
                flyAwayItem(6, tl);
                triggerDroneShow();
                return;
            }
            if (!puzzleActive) return;
            
            const pieceIndex = parseInt(piece.dataset.currentIndex);
            const validNeighbors = getValidNeighbors(blankIndex);
            
            if (validNeighbors.includes(pieceIndex)) {
                // It is adjacent to the blank space! Swap them.
                const pieceW = 320 / puzzleCols;
                const pieceH = 320 / puzzleRows;
                const newBlank = pieceIndex;
                piece.dataset.currentIndex = blankIndex;
                blankIndex = newBlank;
                
                const newCol = piece.dataset.currentIndex % puzzleCols;
                const newRow = Math.floor(piece.dataset.currentIndex / puzzleCols);
                
                gsap.to(piece, { x: newCol * pieceW, y: newRow * pieceH, duration: 0.2 });
                
                setTimeout(checkPuzzleWin, 250);
            }
        }

        function checkPuzzleWin() {
            let won = true;
            puzzlePieces.forEach(p => {
                if (parseInt(p.dataset.correctIndex) !== parseInt(p.dataset.currentIndex)) won = false;
            });
            
            if (won) {
                puzzleActive = false;
                puzzleSolved = true;
                instruction.innerText = txtSolved;
                
                const board = document.getElementById('puzzle-board');
                gsap.to(board, { borderColor: '#10b981', duration: 0.3, yoyo: true, repeat: 3 });
                
                // Remove grid lines
                puzzlePieces.forEach(p => {
                    gsap.to(p, { borderColor: 'transparent', duration: 0.5 });
                });
                
                const pieceW = 320 / puzzleCols;
                const pieceH = 320 / puzzleRows;
                const lastRow = puzzleRows - 1;
                const lastCol = puzzleCols - 1;
                
                // Fill the blank space with the missing last piece!
                const missingPiece = document.createElement('div');
                missingPiece.className = 'puzzle-piece';
                missingPiece.style.width = pieceW + 'px';
                missingPiece.style.height = pieceH + 'px';
                missingPiece.style.backgroundImage = `url('${puzzleImage}')`;
                missingPiece.style.backgroundPosition = `-${lastCol * pieceW}px -${lastRow * pieceH}px`;
                missingPiece.style.opacity = 0;
                missingPiece.style.borderColor = 'transparent';
                gsap.set(missingPiece, { x: lastCol * pieceW, y: lastRow * pieceH });
                board.appendChild(missingPiece);
                gsap.to(missingPiece, { opacity: 1, duration: 1 });
                
                triggerParticleCelebration('🎉');
                
                setTimeout(() => {
                    const tl = gsap.timeline();
                    flyAwayItem(6, tl);
                    
                    triggerDroneShow();
                }, 2000);
            }
        }
    </script>
}
