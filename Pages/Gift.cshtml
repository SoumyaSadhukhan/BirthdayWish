@page
@using Microsoft.Extensions.Configuration
@using System.Linq
@inject IConfiguration Config
@model GiftModel
@{
    ViewData["Title"] = Config["BirthdayConfig:GiftTitle"];
    ViewData["PageTheme"] = "gift";
}

<style>
    .scene-3d {
        perspective: 1000px;
        width: 100%;
        height: 300px;
        display: flex;
        justify-content: center;
        align-items: center;
        margin-top: 2rem;
    }

    .gift-box {
        position: relative;
        width: 200px;
        height: 200px;
        transform-style: preserve-3d;
        transform: rotateX(-20deg) rotateY(45deg);
        cursor: pointer;
        transition: transform 0.5s;
    }
    
    .gift-box:hover {
        transform: rotateX(-20deg) rotateY(45deg) scale(1.05);
    }

    .box-face {
        position: absolute;
        width: 200px;
        height: 200px;
        background: linear-gradient(135deg, #c026d3, #ec4899);
        border: 2px solid #fdf2f8;
    }

    .box-front  { transform: translateZ(100px); }
    .box-back   { transform: rotateY(180deg) translateZ(100px); }
    .box-right  { transform: rotateY(90deg) translateZ(100px); }
    .box-left   { transform: rotateY(-90deg) translateZ(100px); }
    .box-top    { transform: rotateX(90deg) translateZ(100px); background: #fbcfe8; }
    .box-bottom { transform: rotateX(-90deg) translateZ(100px); background: #831843; }

    /* Ribbons */
    .ribbon-v, .ribbon-h {
        position: absolute;
        background: #fbbf24;
    }
    .ribbon-v { width: 40px; height: 100%; left: 80px; top: 0; }
    .ribbon-h { width: 100%; height: 40px; top: 80px; left: 0; }

    .gift-lid {
        position: absolute;
        width: 210px;
        height: 50px;
        top: -50px;
        left: -5px;
        transform-style: preserve-3d;
        z-index: 10;
    }

    .lid-face {
        position: absolute;
        background: linear-gradient(135deg, #a21caf, #db2777);
        border: 2px solid #fdf2f8;
    }

    .lid-front  { width: 210px; height: 50px; transform: translateZ(105px); }
    .lid-back   { width: 210px; height: 50px; transform: rotateY(180deg) translateZ(105px); }
    .lid-right  { width: 210px; height: 50px; transform: rotateY(90deg) translateZ(105px); }
    .lid-left   { width: 210px; height: 50px; transform: rotateY(-90deg) translateZ(105px); }
    .lid-top    { width: 210px; height: 210px; transform: rotateX(90deg) translateZ(105px); }

    #loot-container {
        position: absolute;
        top: 50%;
        left: 50%;
        width: 0;
        height: 0;
        z-index: 15;
    }

    .loot-item {
        position: absolute;
        font-size: 8rem;
        top: 0;
        left: 0;
        transform: scale(0);
        opacity: 0;
        z-index: 5;
        filter: drop-shadow(0 0 30px rgba(251, 191, 36, 1));
        pointer-events: none;
    }

    .loot-item-custom {
        position: absolute;
        top: 0;
        left: 0;
        transform: scale(0);
        opacity: 0;
        z-index: 5;
        pointer-events: none;
    }

    .premium-badge {
        width: 220px;
        height: 220px;
        background-size: contain;
        background-repeat: no-repeat;
        background-position: center;
        filter: drop-shadow(0 20px 30px rgba(0,0,0,0.4));
    }

    .envelope-wrapper {
        position: relative;
        width: 150px;
        height: 100px;
        background: #fdf2f8;
        box-shadow: 0 10px 20px rgba(0,0,0,0.2);
        border: 2px solid #db2777;
        perspective: 800px;
        filter: drop-shadow(0 0 30px rgba(251, 191, 36, 1));
    }
    
    /* Realistic Envelope Folds */
    .envelope-left {
        position: absolute;
        top: 0; left: 0;
        width: 100%; height: 100%;
        background: #fbcfe8;
        clip-path: polygon(0 0, 0 100%, 50% 50%);
        z-index: 3;
    }
    
    .envelope-right {
        position: absolute;
        top: 0; left: 0;
        width: 100%; height: 100%;
        background: #fbcfe8;
        clip-path: polygon(100% 0, 100% 100%, 50% 50%);
        z-index: 3;
    }
    
    .envelope-bottom {
        position: absolute;
        top: 0; left: 0;
        width: 100%; height: 100%;
        background: #f9a8d4;
        clip-path: polygon(0 100%, 100% 100%, 50% 50%);
        z-index: 3;
    }
    
    .envelope-flap {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 65%; /* Extended flap slightly */
        background: #f472b6;
        clip-path: polygon(0 0, 100% 0, 50% 100%);
        transform-origin: top center;
        z-index: 4;
    }
    
    .wax-seal {
        position: absolute;
        bottom: 40px; /* Aligned with the point of the flap */
        left: 50%;
        transform: translate(-50%, 50%);
        width: 24px;
        height: 24px;
        background: #e11d48;
        border-radius: 50%;
        z-index: 5;
        box-shadow: inset 0 0 5px rgba(0,0,0,0.3), 0 2px 4px rgba(0,0,0,0.2);
        display: flex;
        justify-content: center;
        align-items: center;
        color: #fff;
        font-size: 0.6rem;
        font-family: Arial, sans-serif;
    }
    
    /* End of Envelope Styles */
    
    .letter-paper {
        position: absolute;
        bottom: 5px;
        left: 5px;
        width: 136px;
        height: 90px;
        background-color: #fffdf2;
        background-image: linear-gradient(120deg, #fffcf3 0%, #fdf5e0 100%);
        z-index: 2;
        padding: 10px;
        font-family: 'Caveat', cursive;
        font-size: 0.9rem;
        color: #4b5563;
        box-shadow: inset 0 0 10px rgba(0,0,0,0.05), 0 2px 5px rgba(0,0,0,0.1);
        border-radius: 2px;
        overflow: hidden;
    }

    .photo-stack {
        position: relative;
        width: 240px;
        height: 280px;
        filter: drop-shadow(0 0 30px rgba(251, 191, 36, 1));
    }
    
    .photo-card {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background-color: white; /* Fully opaque white */
        padding: 10px 10px 60px 10px; /* Larger Polaroid style */
        box-sizing: border-box;
        border: 1px solid #ccc;
        border-radius: 6px;
        box-shadow: 0 4px 15px rgba(0,0,0,0.3);
        transform-origin: center;
    }
    
    .photo-image {
        width: 100%;
        height: 100%;
        background-size: cover;
        background-position: center;
        background-color: #eee;
    }
    
    .photo-caption {
        position: absolute;
        bottom: 18px;
        left: 0;
        width: 100%;
        text-align: center;
        font-family: 'Outfit', sans-serif;
        font-size: 1.2rem;
        color: #831843;
        font-weight: 600;
    }
    
    .puzzle-board {
        position: relative;
        width: 320px;
        height: 320px;
        background: #eee;
        border: 10px solid white;
        border-radius: 6px;
        box-shadow: 0 4px 15px rgba(0,0,0,0.3);
        box-sizing: content-box;
        overflow: hidden;
        pointer-events: auto !important; /* Force clicks to work */
        z-index: 20;
    }
    
    .puzzle-piece {
        position: absolute;
        width: 80px;
        height: 80px;
        background-size: 320px 320px;
        background-repeat: no-repeat;
        cursor: pointer;
        box-sizing: border-box;
        border: 1px solid rgba(255,255,255,0.4);
        pointer-events: auto !important; /* Force clicks to work */
    }
    
    .puzzle-piece:active {
        transform: scale(0.95);
        filter: brightness(1.2);
    }
    
    @@media (max-width: 400px) {
        .photo-card {
            width: 240px;
            height: 300px;
        }
        
        .puzzle-board {
            transform: scale(0.75);
            margin: -40px auto;
        }
        
        #final-message h1 {
            font-size: 2.2rem !important;
        }
    }

    .butterfly-wing {
        display: inline-block;
        transform-origin: center;
        animation: flapWings 0.18s infinite ease-in-out alternate;
    }
    @@keyframes flapWings {
        0% { transform: scaleX(1) rotate(0deg); }
        100% { transform: scaleX(0.25) rotate(15deg); }
    }

    /* Distinct Vivid Butterfly Color Variants */
    .butterfly-gold {
        filter: sepia(1) hue-rotate(5deg) saturate(7) drop-shadow(0 0 8px rgba(253, 224, 71, 0.95)) !important;
    }
    .butterfly-rose {
        filter: sepia(1) hue-rotate(295deg) saturate(8) drop-shadow(0 0 8px rgba(255, 71, 87, 0.95)) !important;
    }
    .butterfly-cyan {
        filter: sepia(1) hue-rotate(145deg) saturate(7) drop-shadow(0 0 8px rgba(0, 210, 211, 0.95)) !important;
    }
    .butterfly-emerald {
        filter: sepia(1) hue-rotate(85deg) saturate(7) drop-shadow(0 0 8px rgba(16, 172, 132, 0.95)) !important;
    }
    .butterfly-amethyst {
        filter: sepia(1) hue-rotate(220deg) saturate(7) drop-shadow(0 0 8px rgba(156, 136, 255, 0.95)) !important;
    }
    .butterfly-orange {
        filter: sepia(1) hue-rotate(330deg) saturate(9) drop-shadow(0 0 8px rgba(255, 127, 80, 0.95)) !important;
    }

    .drone-tap-prompt {
        position: fixed;
        bottom: 25px;
        left: 50%;
        transform: translateX(-50%);
        z-index: 10001;
        color: rgba(255, 255, 255, 0.9);
        font-family: 'Outfit', sans-serif;
        font-size: 1rem;
        letter-spacing: 1px;
        background: rgba(0, 0, 0, 0.5);
        backdrop-filter: blur(8px);
        padding: 8px 22px;
        border-radius: 30px;
        border: 1px solid rgba(255, 255, 255, 0.25);
        pointer-events: none;
        box-shadow: 0 8px 25px rgba(0, 0, 0, 0.3);
        animation: pulsePrompt 2s infinite ease-in-out;
    }

    @@keyframes pulsePrompt {
        0%, 100% { opacity: 0.7; transform: translateX(-50%) scale(1); }
        50% { opacity: 1; transform: translateX(-50%) scale(1.05); }
    }
</style>

<div id="celebration-container" style="position: fixed; top:0; left:0; width:100%; height:100%; pointer-events: none; overflow: hidden; z-index: 9999;"></div>
<div id="drone-show-container" style="position: fixed; top: 0; left: 0; width: 100vw; height: 100vh; pointer-events: none; overflow: hidden; z-index: 10000;"></div>
<canvas id="text-canvas" style="display: none;"></canvas>

<div class="fullscreen-center" id="gift-scene">
    <div class="glass-panel text-center" style="padding: 4rem; max-width: 800px; z-index: 10; width: 100%;">
        <h2 class="mb-2" id="gift-heading">@Config["BirthdayConfig:GiftHeading"]</h2>
        
        <div class="scene-3d" style="position: relative;">
            <div id="loot-container">
                <div class="loot-item" id="loot-1">
                    <div class="premium-badge" style="background-image: url('/images/image_card/flower_bouquet.png');"></div>
                </div>
                <div class="loot-item" id="loot-2">
                    <div class="premium-badge" style="background-image: url('/images/image_card/teddy_bears.png');"></div>
                </div>
                <div class="loot-item" id="loot-3">
                    <div class="premium-badge" style="background-image: url('/images/image_card/chocolate_bunch.png');"></div>
                </div>
                <div class="loot-item-custom" id="loot-4">
                    <div class="envelope-wrapper">
                        <div class="letter-paper" id="letter-paper">@Html.Raw(Model.LetterText)</div>
                        <div class="envelope-left"></div>
                        <div class="envelope-right"></div>
                        <div class="envelope-bottom"></div>
                        <div class="envelope-flap" id="envelope-flap">
                            <div class="wax-seal" id="wax-seal">❤</div>
                        </div>
                    </div>
                </div>
                <div class="loot-item-custom" id="loot-5">
                    <div class="photo-stack" id="photo-stack">
                        @if (Model.Images.Any())
                        {
                            var rnd = new Random();
                            var i = 0;
                            var captions = Config.GetSection("BirthdayConfig:PhotoCaptions").GetChildren().Select(c => c.Value).ToArray();
                            if (captions.Length == 0) {
                                captions = new[] { "Memory" };
                            }
                            
                            foreach (var img in Model.Images)
                            {
                                var zIndex = Model.Images.Count - i;
                                var rot = (rnd.NextDouble() - 0.5) * 15; // -7.5 to +7.5 deg
                                var cap = captions[i % captions.Length];
                                <div class="photo-card" style="z-index: @zIndex; transform: rotate(@(rot)deg);">
                                    <div class="photo-image" style="background-image: url('/Images/@img');"></div>
                                    <div class="photo-caption">@cap</div>
                                </div>
                                i++;
                            }
                        }
                        else
                        {
                            <div style="font-size: 8rem; text-align: center;">🖼️</div>
                        }
                    </div>
                </div>
                <div class="loot-item-custom" id="loot-6">
                    <div class="puzzle-board" id="puzzle-board"></div>
                </div>
            </div>
            
            <div class="gift-box" id="the-gift-box">
                <!-- Box Base -->
                <div class="box-face box-front"><div class="ribbon-v"></div><div class="ribbon-h"></div></div>
                <div class="box-face box-back"><div class="ribbon-v"></div><div class="ribbon-h"></div></div>
                <div class="box-face box-right"><div class="ribbon-v"></div><div class="ribbon-h"></div></div>
                <div class="box-face box-left"><div class="ribbon-v"></div><div class="ribbon-h"></div></div>
                <div class="box-face box-bottom"></div>
                
                <!-- Box Lid -->
                <div class="gift-lid" id="gift-lid">
                    <div class="lid-face lid-front"><div class="ribbon-v"></div></div>
                    <div class="lid-face lid-back"><div class="ribbon-v"></div></div>
                    <div class="lid-face lid-right"><div class="ribbon-h" style="top:10px; height:20px;"></div></div>
                    <div class="lid-face lid-left"><div class="ribbon-h" style="top:10px; height:20px;"></div></div>
                    <div class="lid-face lid-top"><div class="ribbon-v" style="left:85px;"></div><div class="ribbon-h" style="top:85px;"></div></div>
                </div>
            </div>
        </div>

        <p class="text-white-50 mt-5 mb-0" id="gift-instruction" style="font-size: 1.2rem;">@Config["BirthdayConfig:GiftInstructionInitial"]</p>

        <div id="final-message" style="display: none; margin-top: 2rem;">
            <h1 style="font-size: 3rem; background: linear-gradient(to right, #fbbf24, #f59e0b); -webkit-background-clip: text; -webkit-text-fill-color: transparent;">
                @Config["BirthdayConfig:FinalMessage"]
            </h1>
            <p style="font-size: 1.5rem; color: #fde68a;">@Config["BirthdayConfig:FinalMessageSub"]</p>
            <div class="mt-4">
                <a href="/" class="btn-premium">@Config["BirthdayConfig:ReplayButtonText"] <i class="fa-solid fa-rotate-left ms-2"></i></a>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        const txtNext = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Config["BirthdayConfig:GiftInstructionNext"]));
        const txtScrambled = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Config["BirthdayConfig:PuzzleInstructionScrambled"]));
        const txtSolved = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Config["BirthdayConfig:PuzzleInstructionSolved"]));
        const isPuzzleMode = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Config.GetValue<bool>("BirthdayConfig:IsPuzzle", true)));
        const isLetterMode = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Config.GetValue<bool>("BirthdayConfig:IsLetter", true)));
        const isGalleryMode = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Config.GetValue<bool>("BirthdayConfig:IsGallery", true)));
        const puzzleRows = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Config.GetValue<int>("BirthdayConfig:PuzzleGridRows", 4)));
        const puzzleCols = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Config.GetValue<int>("BirthdayConfig:PuzzleGridCols", 4)));
        
        gsap.from('.glass-panel', { opacity: 0, scale: 0.9, duration: 1, ease: 'power2.out' });
        
        let isOpened = false;
        let currentItem = 0;
        let isAnimating = false;
        let letterOpened = false;
        let photoIndex = 0;
        const totalPhotos = @Model.Images.Count;
        
        const allImages = [
            @foreach(var img in Model.Images)
            {
                <text>'/images/@img',</text>
            }
        ];
        
        let puzzleImage = '';
        let puzzleActive = false;
        let puzzleSolved = false;
        let selectedPiece = null;
        const puzzlePieces = [];
        
        const giftBox = document.getElementById('the-gift-box');
        const lid = document.getElementById('gift-lid');
        const instruction = document.getElementById('gift-instruction');
        const heading = document.getElementById('gift-heading');
        
        const itemEmojis = {
            1: '🌹',
            2: '🧸',
            3: '🍫',
            4: '💌',
            5: '🖼️'
        };
        
        // Idle animation for the box
        gsap.to(giftBox, {
            y: -10,
            duration: 2,
            yoyo: true,
            repeat: -1,
            ease: 'sine.inOut'
        });

        // Listen for taps anywhere on the screen
        document.body.addEventListener('click', (e) => {
            if (isDroneShowActive) {
                stopDroneShow();
                return;
            }
            if (isAnimating) return;
            
            if (!isOpened) {
                // Must tap the box itself to open initially
                if (!e.target.closest('#the-gift-box')) return;
                
                isOpened = true;
                isAnimating = true;
                
                instruction.style.display = 'none';
                heading.innerText = "Surprise!";
                
                const tl = gsap.timeline({ onComplete: () => isAnimating = false });

                // Pop the lid
                tl.to(lid, {
                    y: -250,
                    x: 150,
                    rotationX: 45,
                    rotationY: 45,
                    rotationZ: 45,
                    opacity: 0,
                    duration: 1,
                    ease: 'power2.out'
                }, "0");

                // Expand the box slightly
                tl.to(giftBox, { scale: 1.1, duration: 0.5 }, "0");
                
                // Automatically show the first item
                currentItem = 1;
                showItem(currentItem, tl, "0.5");
                
                // Show instruction to tap for more
                setTimeout(() => {
                    instruction.innerText = txtNext;
                    instruction.style.display = 'block';
                    gsap.fromTo(instruction, {opacity: 0, y:20}, {opacity: 1, y:0, duration:0.5});
                }, 1500);

            } else {
                // Already opened, cycle to next item
                if (currentItem > 0 && currentItem <= 6) {
                    // Check if we are on the letter (item 4) and it hasn't been opened yet
                    if (currentItem === 4 && !letterOpened) {
                        if (!isLetterMode) {
                            letterOpened = true;
                        } else {
                            isAnimating = true;
                            letterOpened = true;
                            
                            const tl = gsap.timeline({ onComplete: () => isAnimating = false });
                            
                            // Open envelope flap and break wax seal
                            tl.to('#wax-seal', { opacity: 0, scale: 0, duration: 0.3 }, 0);
                            tl.to('#envelope-flap', { rotationX: 180, duration: 0.5, ease: 'power2.inOut', zIndex: 1 }, 0);
                            
                            const isMobile = window.innerWidth <= 400;
                            
                            // 1. Slide letter straight UP out of the envelope first (keep it narrow so it doesn't clip the sides)
                            tl.to('#letter-paper', {
                                y: -95, 
                                duration: 0.4, 
                                ease: 'power2.out'
                            }, "+=0.1");
                            
                            // 2. Once it's out, pop it in FRONT of the envelope
                            tl.set('#letter-paper', { zIndex: 10 });
                            
                            // 3. Expand and scale the letter to reading size
                            tl.to('#letter-paper', {
                                y: isMobile ? -30 : -50,
                                x: isMobile ? -50 : -80, // Center horizontally
                                scale: 1, 
                                width: isMobile ? '240px' : '300px',
                                height: 'auto',
                                minHeight: '200px',
                                padding: '20px',
                                fontSize: isMobile ? '1.2rem' : '1.4rem',
                                color: '#1f2937',
                                boxShadow: '0 20px 40px rgba(0,0,0,0.3), inset 0 0 20px rgba(0,0,0,0.05)',
                                duration: 0.6, 
                                ease: 'power2.out'
                            });
                            
                            return; // Stop here, so we don't fly it away yet
                        }
                    }

                    // If puzzle is active and unsolved, block the body tap from flying it away
                    if (currentItem === 6) {
                        if (!isPuzzleMode && !puzzleSolved) {
                            puzzleActive = false;
                            puzzleSolved = true;
                            
                            const tl = gsap.timeline();
                            flyAwayItem(6, tl);
                            
                            triggerDroneShow();
                            return;
                        }
                        if (!puzzleSolved) {
                            instruction.innerText = "Tap two pieces to swap them!";
                            return;
                        }
                    }

                    // Check if we are on the gallery (item 5) and have photos left to swipe
                    if (currentItem === 5 && photoIndex < totalPhotos) {
                        if (!isGalleryMode) {
                            photoIndex = totalPhotos;
                        } else {
                            isAnimating = true;
                            
                            const cards = document.querySelectorAll('.photo-card');
                            if (cards.length > 0 && photoIndex < cards.length) {
                                const currentCard = cards[photoIndex];
                                
                                // Swipe the photo away (throw it to the side)
                                gsap.to(currentCard, {
                                    x: (Math.random() > 0.5 ? 200 : -200), // Randomly throw left or right
                                    y: -200, 
                                    rotation: (Math.random() - 0.5) * 90, 
                                    opacity: 0, 
                                    duration: 0.6, 
                                    ease: 'power2.in',
                                    onComplete: () => isAnimating = false
                                });
                                
                                photoIndex++;
                                return; // Stop here, wait for next tap
                            }
                        }
                    }

                    isAnimating = true;
                    const tl = gsap.timeline({ onComplete: () => isAnimating = false });
                    
                    flyAwayItem(currentItem, tl);
                    
                    currentItem++;
                    
                    if (currentItem <= 6) {
                        showItem(currentItem, tl, "-=0.1");
                    } else {
                        // This else block is no longer the final win state, 
                        // as the puzzle handles its own win state.
                    }
                }
            }
        });

        function showItem(index, tl, position = "+=0") {
            const item = document.getElementById(`loot-${index}`);
            tl.fromTo(item, 
                { opacity: 0, y: 0, scale: 0, xPercent: -50, yPercent: -50 },
                {
                    y: -120, // Hover above the center of the box
                    scale: 1,
                    opacity: 1,
                    rotation: (Math.random() - 0.5) * 15,
                    duration: 0.8,
                    ease: 'back.out(1.5)',
                    onComplete: () => {
                        gsap.to(item, {
                            y: -140, // Subtle hover
                            duration: 1.5,
                            ease: 'sine.inOut',
                            yoyo: true,
                            repeat: -1
                        });
                        
                        if (index === 6) {
                            initPuzzle();
                            scramblePuzzle();
                            triggerParticleCelebration('puzzle');
                        } else if (index === 5) {
                            triggerParticleCelebration('photo');
                        } else if (index === 4) {
