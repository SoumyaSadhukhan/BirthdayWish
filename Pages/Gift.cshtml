        function formatPhraseForScreen(rawPhrase) {
            const isMobile = window.innerWidth <= 650;
            const text = rawPhrase.replace(/\r/g, '').replace(/\n/g, ' ');
            const words = text.split(' ').filter(w => w.trim().length > 0);
            
            // Max 7 chars per line on mobile for huge readable words! Max 12 on desktop.
            const maxCharsPerLine = isMobile ? 7 : 12;
            const lines = [];
            let currentLine = '';
            
            words.forEach(w => {
                if ((currentLine + ' ' + w).trim().length <= maxCharsPerLine) {
                    currentLine = (currentLine + ' ' + w).trim();
                } else {
                    if (currentLine) lines.push(currentLine);
                    currentLine = w;
                }
            });
            if (currentLine) lines.push(currentLine);
            return lines;
        }

        function getTargetCoordsForPhrase(phraseText, droneCount) {
            const canvas = document.getElementById('text-canvas');
            const ctx = canvas.getContext('2d', { willReadFrequently: true });
            
            const screenW = window.innerWidth;
            const screenH = window.innerHeight;
            const isMobile = screenW <= 650;
            
            const w = Math.min(screenW * 0.94, isMobile ? 450 : 1100);
            const h = Math.min(screenH * 0.80, isMobile ? 550 : 750);
            canvas.width = w;
            canvas.height = h;
            
            ctx.clearRect(0, 0, w, h);
            ctx.fillStyle = 'black';
            ctx.fillRect(0, 0, w, h);
            
            const lines = formatPhraseForScreen(phraseText);
            const lineCount = lines.length;
            const maxLineLen = Math.max(...lines.map(l => l.length), 3);
            
            let fontByWidth = Math.floor((w * 0.88) / (maxLineLen * 0.65));
            let fontByHeight = Math.floor((h * 0.82) / (lineCount * 1.3));
            let fontSize = Math.min(fontByWidth, fontByHeight);
            fontSize = Math.max(isMobile ? 36 : 60, Math.min(fontSize, isMobile ? 65 : 110));
            
            ctx.font = `bold ${fontSize}px "Outfit", system-ui, sans-serif`;
            ctx.textAlign = 'center';
            ctx.textBaseline = 'middle';
            ctx.fillStyle = 'white';
            
            const startY = (h / 2) - ((lineCount - 1) * fontSize * 0.65);
            
            lines.forEach((line, idx) => {
                ctx.fillText(line.trim(), w / 2, startY + (idx * fontSize * 1.25));
            });
            
            const imgData = ctx.getImageData(0, 0, w, h).data;
            const rawCoords = [];
            const step = isMobile ? 5 : 7;
            
            for (let y = 0; y < h; y += step) {
                for (let x = 0; x < w; x += step) {
                    const idx = (y * w + x) * 4;
                    if (imgData[idx] > 128) {
                        const screenX = (screenW / 2) - (w / 2) + x;
                        const screenY = (screenH / 2) - (h / 2) + y;
                        rawCoords.push({ x: screenX, y: screenY });
                    }
                }
            }
            
            const finalCoords = [];
            if (rawCoords.length > 0) {
                const totalSamples = rawCoords.length;
                for (let i = 0; i < droneCount; i++) {
                    const sampleIndex = Math.floor((i / droneCount) * totalSamples) % totalSamples;
                    const sample = rawCoords[sampleIndex];
                    finalCoords.push({
                        x: sample.x,
                        y: sample.y
                    });
                }
            } else {
                for (let i = 0; i < droneCount; i++) {
                    finalCoords.push({
                        x: (screenW / 2) + (Math.random() - 0.5) * w * 0.8,
                        y: (screenH / 2) + (Math.random() - 0.5) * h * 0.8
                    });
                }
            }
            return finalCoords;
        }

        // Soft Instrumental "Happy Birthday" Music Box Synthesizer (No voice, loops infinitely during drone show)
        let birthdayAudioCtx = null;
        let isBirthdayMusicPlaying = false;
        let birthdayTuneTimer = null;

        const birthdayNotes = [
            { note: 'G4', dur: 0.75 }, { note: 'G4', dur: 0.25 }, { note: 'A4', dur: 1.0 }, { note: 'G4', dur: 1.0 }, { note: 'C5', dur: 1.0 }, { note: 'B4', dur: 2.0 },
            { note: 'G4', dur: 0.75 }, { note: 'G4', dur: 0.25 }, { note: 'A4', dur: 1.0 }, { note: 'G4', dur: 1.0 }, { note: 'D5', dur: 1.0 }, { note: 'C5', dur: 2.0 },
            { note: 'G4', dur: 0.75 }, { note: 'G4', dur: 0.25 }, { note: 'G5', dur: 1.0 }, { note: 'E5', dur: 1.0 }, { note: 'C5', dur: 1.0 }, { note: 'B4', dur: 1.0 }, { note: 'A4', dur: 1.5 },
            { note: 'F5', dur: 0.75 }, { note: 'F5', dur: 0.25 }, { note: 'E5', dur: 1.0 }, { note: 'C5', dur: 1.0 }, { note: 'D5', dur: 1.0 }, { note: 'C5', dur: 2.5 }
        ];

        const noteFreqs = {
            'G4': 392.00, 'A4': 440.00, 'B4': 493.88,
            'C5': 523.25, 'D5': 587.33, 'E5': 659.25, 'F5': 698.46, 'G5': 783.99
        };

        function playSoftChime(freq, durationSec) {
            if (!birthdayAudioCtx) return;
            try {
                const now = birthdayAudioCtx.currentTime;
                const osc = birthdayAudioCtx.createOscillator();
                const gain = birthdayAudioCtx.createGain();

                osc.type = 'sine';
                osc.frequency.setValueAtTime(freq, now);

                // Soft music box envelope (volume 0.2)
                gain.gain.setValueAtTime(0.001, now);
                gain.gain.linearRampToValueAtTime(0.2, now + 0.04);
                gain.gain.exponentialRampToValueAtTime(0.001, now + durationSec * 0.95);

                osc.connect(gain);
                gain.connect(birthdayAudioCtx.destination);

                osc.start(now);
                osc.stop(now + durationSec);
            } catch(e) {}
        }

        function startSoftBirthdayTune() {
            stopSoftBirthdayTune();
            isBirthdayMusicPlaying = true;
            
            if (!birthdayAudioCtx) {
                const AudioCtxClass = window.AudioContext || window.webkitAudioContext;
                if (AudioCtxClass) birthdayAudioCtx = new AudioCtxClass();
            }
            if (birthdayAudioCtx && birthdayAudioCtx.state === 'suspended') {
                birthdayAudioCtx.resume();
            }

            let noteIndex = 0;
            const beatDuration = 0.45; // seconds per beat

            function scheduleNextNote() {
                if (!isBirthdayMusicPlaying) return;

                const current = birthdayNotes[noteIndex];
                const freq = noteFreqs[current.note];
                const durSec = current.dur * beatDuration;

                if (freq) {
                    playSoftChime(freq, durSec * 1.2);
                }

                noteIndex = (noteIndex + 1) % birthdayNotes.length;
                birthdayTuneTimer = setTimeout(scheduleNextNote, durSec * 1000);
            }

            scheduleNextNote();
        }

        function stopSoftBirthdayTune() {
            isBirthdayMusicPlaying = false;
            if (birthdayTuneTimer) {
                clearTimeout(birthdayTuneTimer);
                birthdayTuneTimer = null;
            }
        }

        function startDroneShowLoop() {
            startSoftBirthdayTune();
            const container = document.getElementById('drone-show-container');
            container.innerHTML = '';
            activeDrones = [];
            clearAllDroneTimeouts();
            
            const isMobile = window.innerWidth <= 650;
            const numDrones = isMobile ? 260 : 360;
            const centerX = window.innerWidth / 2;
            const centerY = window.innerHeight / 2;
            
            for (let i = 0; i < numDrones; i++) {
                const drone = document.createElement('div');
                drone.style.position = 'absolute';
                drone.style.left = '0';
                drone.style.top = '0';
                drone.style.fontSize = isMobile ? '1.15rem' : '1.35rem';
                drone.style.filter = 'drop-shadow(0 2px 4px rgba(0, 0, 0, 0.7))';
                drone.style.opacity = '0';
                drone.style.transform = 'translate(-50%, -50%)';
                
                const colorClasses = ['butterfly-gold', 'butterfly-rose', 'butterfly-cyan', 'butterfly-emerald', 'butterfly-amethyst', 'butterfly-orange'];
                const assignedColor = colorClasses[i % colorClasses.length];
                
                const wing = document.createElement('span');
                wing.className = `butterfly-wing ${assignedColor}`;
                wing.innerText = '🦋';
                wing.style.animationDuration = (0.14 + Math.random() * 0.1) + 's';
                drone.appendChild(wing);
                
                gsap.set(drone, { x: centerX, y: centerY });
                container.appendChild(drone);
                activeDrones.push(drone);
                
                // Full screen 100vw and 100vh initial flight
                const flutterX = Math.random() * window.innerWidth;
                const flutterY = Math.random() * window.innerHeight;
                
                gsap.to(drone, {
                    x: flutterX,
                    y: flutterY,
                    rotation: (Math.random() - 0.5) * 360,
                    opacity: 1,
                    duration: 1.2 + Math.random() * 0.8,
                    ease: 'power2.out',
                    onComplete: () => {
                        if (!isDroneShowActive) return;
                        gsap.to(drone, {
                            x: `+=${(Math.random() - 0.5) * 180}`,
                            y: `+=${(Math.random() - 0.5) * 180}`,
                            rotation: `+=${(Math.random() - 0.5) * 120}`,
                            duration: 1.5 + Math.random() * 1.5,
                            repeat: -1,
                            yoyo: true,
                            ease: 'sine.inOut'
                        });
                    }
                });
            }

            let phraseIndex = 0;

            function runPhraseCycle() {
                if (!isDroneShowActive) return;
                
                const phraseText = dronePhrases[phraseIndex % dronePhrases.length];
                const targetCoords = getTargetCoordsForPhrase(phraseText, activeDrones.length);
                
                // 1. Arrange: Drones fly smoothly to letter coordinates and STOP COMPLETELY STILL!
                activeDrones.forEach((drone, i) => {
                    gsap.killTweensOf(drone);
                    const target = targetCoords[i];
                    gsap.to(drone, {
                        x: target.x,
                        y: target.y,
                        rotation: 0,
                        duration: droneArrangeDurationSec,
                        ease: 'power3.out'
                    });
                });

                // Total hold time = arrange time + showtime (holding still)
                const holdDelayMs = (droneArrangeDurationSec + droneShowtimeSec) * 1000;

                // 2. Spread: After showtime, scatter butterflies across 100vw and 100vh
                addDroneTimeout(() => {
                    if (!isDroneShowActive) return;
                    
                    activeDrones.forEach((drone) => {
                        gsap.killTweensOf(drone);
                        gsap.to(drone, {
                            x: Math.random() * window.innerWidth,
                            y: Math.random() * window.innerHeight,
                            rotation: (Math.random() - 0.5) * 180,
                            duration: droneSpreadDurationSec,
                            ease: 'power2.inOut'
                        });
                    });

                    // 3. Next line: Advance to next phrase after spread duration
                    addDroneTimeout(() => {
                        if (!isDroneShowActive) return;
                        phraseIndex++;
                        runPhraseCycle();
                    }, droneSpreadDurationSec * 1000);

                }, holdDelayMs);
            }

            // Start first phrase cycle after initial flutter duration
            addDroneTimeout(runPhraseCycle, droneFlutterDurationSec * 1000);
        }

        function stopDroneShow() {
            if (!isDroneShowActive) return;
            isDroneShowActive = false;
            stopSoftBirthdayTune();
            clearAllDroneTimeouts();
            
            const promptElem = document.getElementById('drone-tap-prompt');
