@page
@model IndexModel
@{
    ViewData["Title"] = "Waiting for the Moment";
}

<div class="fullscreen-center" id="countdown-scene">
    <div class="glass-panel" style="padding: 3rem 4rem;">
        <h2 class="mb-4">Something special is coming...</h2>
        
        <div id="countdown-timer" class="d-flex justify-content-center gap-4 mt-4" style="font-size: 2.5rem; font-weight: 800; text-shadow: 0 0 20px rgba(236,72,153,0.5);">
            <div class="time-block d-flex flex-column align-items-center">
                <span id="days">00</span>
                <span style="font-size: 1rem; font-weight: 400; color: #cbd5e1; text-transform: uppercase; letter-spacing: 2px;">Days</span>
            </div>
            <div class="time-block d-flex flex-column align-items-center">
                <span>:</span>
                <span>&nbsp;</span>
            </div>
            <div class="time-block d-flex flex-column align-items-center">
                <span id="hours">00</span>
                <span style="font-size: 1rem; font-weight: 400; color: #cbd5e1; text-transform: uppercase; letter-spacing: 2px;">Hours</span>
            </div>
            <div class="time-block d-flex flex-column align-items-center">
                <span>:</span>
                <span>&nbsp;</span>
            </div>
            <div class="time-block d-flex flex-column align-items-center">
                <span id="minutes">00</span>
                <span style="font-size: 1rem; font-weight: 400; color: #cbd5e1; text-transform: uppercase; letter-spacing: 2px;">Minutes</span>
            </div>
            <div class="time-block d-flex flex-column align-items-center">
                <span>:</span>
                <span>&nbsp;</span>
            </div>
            <div class="time-block d-flex flex-column align-items-center">
                <span id="seconds">00</span>
                <span style="font-size: 1rem; font-weight: 400; color: #cbd5e1; text-transform: uppercase; letter-spacing: 2px;">Seconds</span>
            </div>
        </div>

        <div id="action-container" class="mt-5" style="display: none; opacity: 0;">
            <a href="/Wish" class="btn-premium">Begin Journey <i class="fa-solid fa-arrow-right ms-2"></i></a>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        const targetDate = new Date("@Model.TargetDate").getTime();
        const actionContainer = document.getElementById('action-container');
        let timerInterval;

        function updateCountdown() {
            const now = new Date().getTime();
            const distance = targetDate - now;

            if (distance <= 0) {
                clearInterval(timerInterval);
                document.getElementById('countdown-timer').style.display = 'none';
                
                // Show continue button
                actionContainer.style.display = 'block';
                gsap.to(actionContainer, { opacity: 1, y: -10, duration: 1, ease: 'power2.out' });
                return;
            }

            const days = Math.floor(distance / (1000 * 60 * 60 * 24));
            const hours = Math.floor((distance % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60));
            const minutes = Math.floor((distance % (1000 * 60 * 60)) / (1000 * 60));
            const seconds = Math.floor((distance % (1000 * 60)) / 1000);

            document.getElementById("days").innerText = days.toString().padStart(2, '0');
            document.getElementById("hours").innerText = hours.toString().padStart(2, '0');
            document.getElementById("minutes").innerText = minutes.toString().padStart(2, '0');
            document.getElementById("seconds").innerText = seconds.toString().padStart(2, '0');
        }

        updateCountdown();
        timerInterval = setInterval(updateCountdown, 1000);
        
        // Initial entrance animation
        gsap.from('.glass-panel', { opacity: 0, scale: 0.9, duration: 1, ease: 'back.out(1.5)' });
    </script>
}
