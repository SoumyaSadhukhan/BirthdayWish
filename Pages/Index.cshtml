@page
@using Microsoft.Extensions.Configuration
@inject IConfiguration Config
@model IndexModel
@{
    ViewData["Title"] = Config["BirthdayConfig:IndexTitle"];
    ViewData["PageTheme"] = "index";
}

<div class="fullscreen-center" id="countdown-scene">
    <div class="glass-panel p-3 p-sm-4 p-md-5" style="max-width: 95vw;">
        <h2 class="mb-3 mb-md-4">@Config["BirthdayConfig:IndexHeading"]</h2>
        
        <div id="angel-demo-target" class="d-flex flex-row flex-nowrap align-items-center justify-content-center">
            <div class="time-block d-flex flex-row align-items-baseline">
                <span id="days" class="timer-digit">00</span>
                <span class="timer-label">@Config["BirthdayConfig:IndexDaysLabel"]</span>
            </div>
            <div class="time-separator">:</div>
            <div class="time-block d-flex flex-row align-items-baseline">
                <span id="hours" class="timer-digit">00</span>
                <span class="timer-label">@Config["BirthdayConfig:IndexHoursLabel"]</span>
            </div>
            <div class="time-separator">:</div>
            <div class="time-block d-flex flex-row align-items-baseline">
                <span id="minutes" class="timer-digit">00</span>
                <span class="timer-label">@Config["BirthdayConfig:IndexMinutesLabel"]</span>
            </div>
            <div class="time-separator">:</div>
            <div class="time-block d-flex flex-row align-items-baseline">
                <span id="seconds" class="timer-digit">00</span>
                <span class="timer-label">@Config["BirthdayConfig:IndexSecondsLabel"]</span>
            </div>
        </div>

        <div id="action-container" class="mt-5" style="display: none; opacity: 0;">
            <a href="/Wish" class="btn-premium">@Config["BirthdayConfig:IndexButtonText"] <i class="fa-solid fa-arrow-right ms-2"></i></a>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        const targetDate = new Date("@Model.TargetDate").getTime();
        const actionContainer = document.getElementById('action-container');
        let timerInterval;

        const msgWaiting = "@Html.Raw(Config["BirthdayConfig:AngelGuideMessages:Screen1_Index_Waiting"])";
        const msgFinished = "@Html.Raw(Config["BirthdayConfig:AngelGuideMessages:Screen1_Index_Finished"])";

        window.AngelGuide = {
            hasSpokenWaiting: false,
            sayWaiting: function(timeString) {
                if (!window.angelController || !window.angelController.isInitialized) return;
                
                // Only say the waiting message once after the angel has finished the intro
                if (!this.hasSpokenWaiting && window.angelController.state === 'Hovering' && !window.angelController.dialogue.isVisible) {
                    window.angelController.say(msgWaiting.replace('{0}', timeString), { duration: 8000 });
                    this.hasSpokenWaiting = true;
                }
            },
            setFinished: function() {
                if (!window.angelController || !window.angelController.isInitialized) return;
                window.angelController.say(msgFinished, { duration: 8000 });
            }
        };

        function updateCountdown() {
            const now = new Date().getTime();
            const distance = targetDate - now;

            if (distance <= 0) {
                clearInterval(timerInterval);
                const timerElem = document.getElementById('angel-demo-target');
                if (timerElem) timerElem.style.display = 'none';
                
                // Show continue button
                actionContainer.style.display = 'block';
                gsap.to(actionContainer, { opacity: 1, y: -10, duration: 1, ease: 'power2.out' });

                if (window.AngelGuide && typeof window.AngelGuide.setFinished === 'function') {
                    window.AngelGuide.setFinished();
                }
                return;
            }

            const days = Math.floor(distance / (1000 * 60 * 60 * 24));
            const hours = Math.floor((distance % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60));
            const minutes = Math.floor((distance % (1000 * 60 * 60)) / (1000 * 60));
            const seconds = Math.floor((distance % (1000 * 60)) / 1000);

            document.getElementById("days").innerText = days.toString().padStart(2, '0');
            document.getElementById("hours").innerText = hours.toString().padStart(2, '0');
            document.getElementById("minutes").innerText = minutes.toString().padStart(2, '0');
            document.getElementById("seconds").innerText = seconds.toString().padStart(2, '0');

            if (window.AngelGuide && typeof window.AngelGuide.sayWaiting === 'function') {
                let timeParts = [];
                if (days > 0) timeParts.push(`${days}d`);
                if (hours > 0) timeParts.push(`${hours}h`);
                if (minutes > 0) timeParts.push(`${minutes}m`);
                timeParts.push(`${seconds}s`);
                window.AngelGuide.sayWaiting(timeParts.join(' '));
            }
        }

        updateCountdown();
        timerInterval = setInterval(updateCountdown, 1000);
        
        // Initial entrance animation
        gsap.from('.glass-panel', { opacity: 0, scale: 0.9, duration: 1, ease: 'back.out(1.5)' });
    </script>
}
