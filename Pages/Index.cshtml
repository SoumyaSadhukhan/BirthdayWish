@page
@model IndexModel
@{
    ViewData["Title"] = "Happy Birthday";
}

<script id="birthday-data" type="application/json">
@Html.Raw(Model.ClientConfigJson)
</script>

<!-- Global Controls -->
<button id="audio-toggle" class="global-btn" aria-label="Toggle audio">
    <span class="icon">🔊</span>
</button>

<div id="app-container">

    <!-- Loading State -->
    <section id="state-loading" class="state-section active">
        <div class="loading-content">
            <div class="loading-balloon">🎈</div>
            <h2>Preparing your birthday...</h2>
            <div class="progress-bar"><div class="progress-fill"></div></div>
        </div>
    </section>

    <!-- Welcome State -->
    <section id="state-welcome" class="state-section">
        <div class="welcome-content text-center">
            <h1 class="welcome-title"></h1>
            <p class="welcome-message"></p>
            <button id="btn-enter" class="primary-btn mt-4">Let's celebrate 🎉</button>
        </div>
    </section>

    <!-- Countdown State -->
    <section id="state-countdown" class="state-section">
        <div class="countdown-content text-center">
            <h2 class="countdown-title"></h2>
            <div id="countdown-timer" class="countdown-timer">
                <div class="time-block">
                    <span class="time-value" id="cd-days">00</span>
                    <span class="time-label">Days</span>
                </div>
                <div class="time-block">
                    <span class="time-value" id="cd-hours">00</span>
                    <span class="time-label">Hours</span>
                </div>
                <div class="time-block">
                    <span class="time-value" id="cd-minutes">00</span>
                    <span class="time-label">Minutes</span>
                </div>
                <div class="time-block">
                    <span class="time-value" id="cd-seconds">00</span>
                    <span class="time-label">Seconds</span>
                </div>
            </div>
            <button id="btn-skip-countdown" class="secondary-btn mt-4 hidden">Enter Party</button>
        </div>
    </section>

    <!-- Main Party Room -->
    <section id="state-party" class="state-section">
        <!-- Ambient Background -->
        <div id="party-bg"></div>
        <div id="party-particles"></div>
        <div id="balloons-container"></div>
        
        <!-- Progress Indicator -->
        <div id="party-progress" class="progress-indicator">
            <span class="prog-item" data-stage="cake">🎂</span>
            <span class="prog-item" data-stage="gift">🎁</span>
            <span class="prog-item" data-stage="surprises">✨</span>
            <span class="prog-item" data-stage="final">❤️</span>
        </div>

        <!-- Center Stage -->
        <div id="center-stage" class="center-stage">
            
            <!-- CAKE -->
            <div id="cake-container" class="interactive-object hidden">
                <h2 class="stage-title" id="cake-title"></h2>
                <div class="cake-visual">
                    <div class="cake-layer bottom"></div>
                    <div class="cake-layer middle"></div>
                    <div class="cake-layer top">
                        <div class="candles" id="candles-container"></div>
                    </div>
                    <div id="cake-cut-line"></div>
                </div>
                <div class="cake-instructions">Drag knife to cut</div>
                <button id="btn-cut-cake" class="primary-btn mt-4">Cut the Cake 🎂</button>
            </div>

            <!-- CELEBRATION TEXT -->
            <div id="celebration-text" class="hidden">
                <h1 class="huge-text">HAPPY BIRTHDAY <br/> <span id="celeb-name"></span>!!!</h1>
            </div>

            <!-- VOICE MESSAGE -->
            <div id="voice-container" class="interactive-object hidden">
                <div class="voice-icon">🎙️</div>
                <h2 class="stage-title">There is something I wanted you to hear...</h2>
                <button id="btn-play-voice" class="primary-btn mt-4">▶ Play My Birthday Message ❤️</button>
                <div id="voice-visualizer" class="hidden">
                    <div class="bar"></div><div class="bar"></div><div class="bar"></div>
                </div>
            </div>

            <!-- GIFT BOX -->
            <div id="gift-container" class="interactive-object hidden">
                <h2 class="stage-title" id="gift-title"></h2>
                <p class="stage-subtitle">Click to open</p>
                <div class="gift-visual" id="the-gift">
                    <div class="gift-box"></div>
                    <div class="gift-lid"></div>
                    <div class="gift-ribbon-v"></div>
                    <div class="gift-ribbon-h"></div>
                    <div class="gift-bow"></div>
                </div>
            </div>

        </div>

        <!-- Surprises Grid (Shown after gift is opened) -->
        <div id="surprises-grid" class="hidden">
            <!-- Populated by JS -->
        </div>

    </section>

    <!-- Overlay Containers for Surprises -->
    <div id="overlay-container" class="overlay hidden">
        <button id="btn-close-overlay" class="close-btn">×</button>
        <div id="overlay-content">
            <!-- Injected content based on surprise type -->
        </div>
    </div>

    <!-- Final State -->
    <section id="state-final" class="state-section">
        <div class="final-content">
            <div class="final-image-container" id="final-image-wrapper"></div>
            <h1 class="final-title" id="final-title"></h1>
            <div class="final-message" id="final-message"></div>
            <button id="btn-replay" class="secondary-btn mt-5">Celebrate Again 🎉</button>
        </div>
    </section>

</div>

@section Scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.2/gsap.min.js"></script>
    <script src="~/js/sound.js" asp-append-version="true"></script>
    <script src="~/js/particles.js" asp-append-version="true"></script>
    <script src="~/js/cake.js" asp-append-version="true"></script>
    <script src="~/js/gifts.js" asp-append-version="true"></script>
    <script src="~/js/gallery.js" asp-append-version="true"></script>
    <script src="~/js/birthday.js" asp-append-version="true"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
}
